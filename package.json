{
  "name": "visbug-mcp-ru",
  "version": "0.26.3",
  "type": "module",
  "description": "VisBug Bridge (RU): буфер правок VisBug → копирование в Cursor",
  "author": "Nikita Kulikov <https://samsebeingener.ru>",
  "repository": {
    "type": "git",
    "url": "https://github.com/samsebeingener/visbug-mcp-ru.git"
  },
  "homepage": "https://samsebeingener.ru",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "daemon": "node src/ws-daemon.js",
    "daemon:watch": "node --watch src/ws-daemon.js",
    "setup": "node scripts/setup.mjs",
    "setup:quick": "node scripts/setup.mjs --yes",
    "icons": "python scripts/generate-extension-icons.py",
    "health": "node scripts/health-check.mjs",
    "pretest": "node scripts/sync-extension-version.mjs",
    "test": "node --test test/*.test.js",
    "sync:extension": "node scripts/sync-extension-version.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0"
  }
}
